{
  "name": "skylers-miniplayer",
  "version": "1.1.0",
  "description": "Aesthetic retro-pixel and ambient-glass desktop miniplayer for Windows, powered by the Windows SMTC API (works with Apple Music, Spotify, browsers, and any other media app).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "check": "node --check main.js && node --check preload.js && node --check lyrics_manager.js && node --check src/renderer.js"
  },
  "keywords": [
    "miniplayer",
    "pixel-art",
    "retro",
    "lyrics",
    "aesthetic",
    "electron",
    "windows",
    "smtc"
  ],
  "author": "Dirya Ramadhan (skilerrr)",
  "license": "MIT",
  "build": {
    "appId": "com.skilerrr.skylersminiplayer",
    "productName": "Skyler's Miniplayer",
    "asar": true,
    "asarUnpack": [
      "smtc_bridge.ps1"
    ],
    "files": [
      "**/*",
      "!.git/*",
      "!.vscode/*",
      "!docs/*",
      "!*.md",
      "!test_*.ps1",
      "!test_*.js",
      "!build/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skyler's Miniplayer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skilerrr/skylers-miniplayer.git"
  },
  "homepage": "https://github.com/skilerrr/skylers-miniplayer#readme",
  "bugs": {
    "url": "https://github.com/skilerrr/skylers-miniplayer/issues"
  }
}
