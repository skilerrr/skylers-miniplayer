{
  "name": "apple-music-pixel-miniplayer",
  "version": "1.0.0",
  "description": "Aesthetic Retro Pixelated Miniplayer for Apple Music and Windows Media",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": [
    "apple-music",
    "miniplayer",
    "pixel-art",
    "retro",
    "lyrics",
    "aesthetic"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "build": {
    "appId": "com.skilerrr.applemusicminiplayer",
    "productName": "Apple Music Miniplayer",
    "asar": true,
    "asarUnpack": [
      "smtc_bridge.ps1",
      "AppVolumeHelper.cs"
    ],
    "files": [
      "**/*",
      "!test_*.ps1",
      "!cover_temp.jpg",
      "!.git/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apple Music Miniplayer"
    }
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3"
  }
}
